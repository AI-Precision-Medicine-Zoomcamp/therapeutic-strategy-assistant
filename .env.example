# Optional: enables generated RAG answers.
# Without this key, the local RAG pipeline still retrieves evidence and returns
# an evidence-only fallback response.
OPENAI_API_KEY=

# Optional model override.
OPENAI_MODEL=gpt-4.1-mini

# Optional answer evaluation mode: llm or off.
ANSWER_EVALUATION_MODE=llm

# Optional token price inputs for local estimated cost reporting.
# Leave as 0 if you do not want cost estimates.
OPENAI_INPUT_PRICE_PER_1M=0
OPENAI_OUTPUT_PRICE_PER_1M=0

# Local PostgreSQL settings for monitoring.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=therapeutic_strategy
POSTGRES_USER=user
POSTGRES_PASSWORD=password
