# ===== Secrets — NEVER commit =====
.env
.env.local
.env.*.local
*.key
# NOTE: .env.example IS committed (it's a safe template with no real values)

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Virtual environment (uv) =====
# .venv is machine-specific and huge; recreate it with `uv sync`.
# uv.lock and pyproject.toml ARE committed so the env is reproducible.
.venv/
venv/
env/

# ===== Jupyter notebooks =====
.ipynb_checkpoints/
*.ipynb.bak
*.ipynb.*.bak

# ===== Generated data & databases =====
# These are regenerated by the notebooks / ingestion pipeline.
data/raw/
data/processed/
*.csv
*.db
*.sqlite3
chroma_db/
faq.db

# ===== OS / editor =====
.DS_Store
Thumbs.db
.vscode/
.idea/

# ===== Markdown — hide ALL .md except README.md =====
# Keeps planning docs (prd.md, docs/*.md) private; only README.md is published.
*.md
!README.md

